 use crate::error::BlobstoreError;
 use crate::tracker::{PageId, ValuePointer};
 
+/// Experiment hook: read granularity for Gridstore page reads.
+///
+/// `QDRANT_GRAN=<bytes>` widens every page read to the enclosing `<bytes>`-aligned window
+/// (clipped to the page file) and returns only the requested bytes. Unset or 0 = stock.
+/// `QDRANT_GRAN_STATS=<path>` makes a background thread write cumulative counters there
+/// every 500 ms: reads issued, value bytes requested, bytes actually read.
+pub(crate) mod gran {
+    use std::borrow::Cow;
+    use std::sync::LazyLock;
+    use std::sync::atomic::{AtomicU64, Ordering};
+    use std::time::Duration;
+
+    use common::universal_io::ReadRange;
+
+    static READS: AtomicU64 = AtomicU64::new(0);
+    static VALUE_BYTES: AtomicU64 = AtomicU64::new(0);
+    static IO_BYTES: AtomicU64 = AtomicU64::new(0);
+
+    static G: LazyLock<u64> = LazyLock::new(|| {
+        let g = std::env::var("QDRANT_GRAN")
+            .ok()
+            .and_then(|v| v.trim().parse::<u64>().ok())
+            .unwrap_or(0);
+        if let Ok(path) = std::env::var("QDRANT_GRAN_STATS") {
+            std::thread::spawn(move || {
+                loop {
+                    std::thread::sleep(Duration::from_millis(500));
+                    let line = format!(
+                        "{{\"gran\":{g},\"reads\":{},\"value_bytes\":{},\"io_bytes\":{}}}\n",
+                        READS.load(Ordering::Relaxed),
+                        VALUE_BYTES.load(Ordering::Relaxed),
+                        IO_BYTES.load(Ordering::Relaxed),
+                    );
+                    let tmp = format!("{path}.tmp");
+                    if std::fs::write(&tmp, line).is_ok() {
+                        let _ = std::fs::rename(&tmp, &path);
+                    }
+                }
+            });
+        }
+        log::info!("gridstore read granularity: {g} bytes (0 = stock)");
+        g
+    });
+
+    /// Widen `range` to the `G`-aligned window inside a page of `page_len` bytes.
+    /// Returns the range to read, how many leading bytes to skip, and the requested length.
+    pub fn widen(range: ReadRange, page_len: u64) -> (ReadRange, usize, usize) {
+        let ReadRange {
+            byte_offset,
+            length,
+        } = range;
+        let g = *G;
+        READS.fetch_add(1, Ordering::Relaxed);
+        VALUE_BYTES.fetch_add(length, Ordering::Relaxed);
+        if g == 0 || length == 0 {
+            IO_BYTES.fetch_add(length, Ordering::Relaxed);
+            return (range, 0, length as usize);
+        }
+        let end = byte_offset + length;
+        let start = byte_offset / g * g;
+        let wide_end = end.div_ceil(g).saturating_mul(g).min(page_len).max(end);
+        IO_BYTES.fetch_add(wide_end - start, Ordering::Relaxed);
+        (
+            ReadRange {
+                byte_offset: start,
+                length: wide_end - start,
+            },
+            (byte_offset - start) as usize,
+            length as usize,
+        )
+    }
+
+    /// Cut the requested bytes out of a widened read.
+    pub fn trim(bytes: Cow<'_, [u8]>, skip: usize, len: usize) -> Cow<'_, [u8]> {
+        if skip == 0 && bytes.len() == len {
+            return bytes;
+        }
+        assert!(
+            bytes.len() >= skip + len,
+            "widened read returned {} bytes, need {}..{}",
+            bytes.len(),
+            skip,
+            skip + len
+        );
+        match bytes {
+            Cow::Borrowed(b) => Cow::Borrowed(&b[skip..skip + len]),
+            Cow::Owned(b) => Cow::Owned(b[skip..skip + len].to_vec()),
+        }
+    }
+}
+
 pub fn page_path(base_path: &Path, page_id: PageId) -> PathBuf {
     base_path.join(format!("page_{page_id}.dat"))
 }
